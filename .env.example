# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# SUPABASE POSTGRESQL & ROW-LEVEL SECURITY (RLS)
# ------------------------------------------------------------------------------
# Direct or pooled PostgreSQL connection string from Supabase Connect -> Connection string
DATABASE_URL=""
# Optional Supabase REST keys (commented out so deploy only asks for DATABASE_URL):
# SUPABASE_URL=""
# SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------------------------------------------
# BETTER AUTH (Staff & Admin Authentication)
# ------------------------------------------------------------------------------
# Random 32+ character cryptographic secret for signing session cookies
BETTER_AUTH_SECRET=""
# Base URL of the Sangira Express server (uses Cloud Run APP_URL or localhost:3000 automatically)
BETTER_AUTH_URL="https://ais-pre-dqujihwjoqdk3ympbxjpk3-12811345430.europe-west2.run.app"

# ------------------------------------------------------------------------------
# RESEND + REACT EMAIL (Transactional Hospitality Emails)
# ------------------------------------------------------------------------------
RESEND_API_KEY=""
# Verified sender address in Resend (defaults to Resend test sender if unchanged)
RESEND_FROM_EMAIL="Sangira Hospitality <onboarding@resend.dev>"

